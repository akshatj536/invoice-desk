# Gemini (Google AI Studio key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google Sheet used as the PO / vendor / invoice-log system of record
GOOGLE_SHEET_ID=
# Path to the service-account JSON (keep it outside git, e.g. secrets/service-account.json)
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service-account.json

# "gsheets" (default) or "memory" (offline, seeded from data/seed/*.json)
STORE_BACKEND=gsheets
